@model LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Prawns Farm</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <div class="login-bg" style="background-image:url('/img/login-bg.jpg?v=3')" aria-hidden="true"></div>
    <div class="login-overlay" aria-hidden="true"></div>
    <div class="bubbles" id="bubbles" aria-hidden="true"></div>

    <div class="auth-card">
        @* ---- Left: quote + feature tiles ---- *@
        <section class="auth-left">
            <h2 class="auth-quote">A SMART WAY TO<br />MANAGE YOUR<br /><span>PRAWN FARM</span></h2>
            <div class="auth-features">
                <div class="auth-feat"><span class="af-ic"><i class="bi bi-cart-check"></i></span><span class="af-tx">Track Expenses</span></div>
                <div class="auth-feat"><span class="af-ic"><i class="bi bi-droplet-half"></i></span><span class="af-tx">Monitor Ponds</span></div>
                <div class="auth-feat"><span class="af-ic"><i class="bi bi-box-seam"></i></span><span class="af-tx">Manage Inventory</span></div>
                <div class="auth-feat"><span class="af-ic"><i class="bi bi-graph-up-arrow"></i></span><span class="af-tx">Grow Profits</span></div>
            </div>
        </section>

        @* ---- Right: white login card ---- *@
        <div class="auth-right">
            <div class="auth-brand">
                <div class="auth-logo"><img src="~/img/logo.svg" alt="Prawns Farm" /></div>
                <h1>PRAWNS <span>FARM</span></h1>
                <p>Manage Farm Expenses, Grow Profits</p>
            </div>

            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label">Username</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="Username" class="form-control" placeholder="Enter username" autofocus />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" id="pwd" />
                        <button type="button" class="input-group-text pwd-toggle" id="pwdToggle" tabindex="-1" aria-label="Show password"><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                </div>

                <button type="submit" class="btn btn-success w-100 btn-lg btn-dive"><i class="bi bi-box-arrow-in-right"></i> Sign In</button>
            </form>
        </div>
    </div>

    <script>
        (function () {
            var layer = document.getElementById('bubbles');
            if (!layer || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            function rand(a, b) { return Math.random() * (b - a) + a; }
            function spawn() {
                var b = document.createElement('span');
                b.className = 'bubble';
                var s = rand(6, 26);
                b.style.width = s + 'px'; b.style.height = s + 'px';
                b.style.left = rand(0, 100) + 'vw';
                var d = rand(6, 14);
                b.style.animationDuration = d + 's';
                b.style.setProperty('--drift', rand(-60, 60) + 'px');
                b.style.opacity = rand(0.2, 0.6);
                layer.appendChild(b);
                setTimeout(function () { b.remove(); }, d * 1000 + 200);
            }
            for (var i = 0; i < 12; i++) setTimeout(spawn, i * 250);
            setInterval(function () { var n = Math.floor(rand(1, 3)); for (var j = 0; j < n; j++) spawn(); }, 800);
        })();

        (function () {
            var btn = document.getElementById('pwdToggle'), pwd = document.getElementById('pwd');
            if (!btn || !pwd) return;
            btn.addEventListener('click', function () {
                var show = pwd.type === 'password';
                pwd.type = show ? 'text' : 'password';
                btn.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        })();
    </script>
</body>
</html>
