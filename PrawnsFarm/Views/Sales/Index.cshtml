@model List<Sale>
@using System.Globalization
@{
    ViewData["Title"] = "Sales";
    var inr = new CultureInfo("en-IN");
    DateTime from = ViewBag.From;
    DateTime to = ViewBag.To;
    decimal total = ViewBag.Total;
    decimal totalKg = ViewBag.TotalKg;
    string M(decimal v) => "₹ " + v.ToString("N0", inr);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-cash-stack text-success"></i> Sales / Harvest Income</h4>
    <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-lg"></i> Record Sale</a>
</div>

<form method="get" class="filter-bar card-surface mb-3">
    <div class="range-inputs flex-wrap">
        <input type="date" name="From" value="@from.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        <span class="text-muted">to</span>
        <input type="date" name="To" value="@to.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-funnel"></i> Filter</button>
        <a href="@Url.Action("Index", new { preset = "all" })" class="btn btn-sm btn-outline-secondary">Reset</a>
    </div>
    <div class="ms-auto fw-semibold">Total: <span class="text-success">@M(total)</span> · @totalKg.ToString("N0", inr) kg</div>
</form>

<div class="card-surface">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>Date</th><th>Crop</th><th class="text-end">Qty (kg)</th><th class="text-end">Rate/kg</th><th class="text-end">Amount</th><th>Buyer</th><th>Payment</th><th class="text-end">Action</th></tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No sales in this range.</td></tr>
            }
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Date.ToString("dd MMM yyyy")</td>
                    <td>@s.Crop</td>
                    <td class="text-end">@s.QuantityKg.ToString("N0", inr)</td>
                    <td class="text-end">@M(s.RatePerKg)</td>
                    <td class="text-end fw-semibold text-success">@M(s.Amount)</td>
                    <td>@s.Buyer</td>
                    <td><span class="badge bg-light text-dark">@s.PaymentMode</span></td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this sale?');">
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
