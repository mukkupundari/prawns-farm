@{
    ViewData["Title"] = "Error";
}
<div class="card-surface text-center py-5">
    <h3 class="text-danger"><i class="bi bi-exclamation-octagon"></i> Something went wrong</h3>
    <p class="text-muted">An unexpected error occurred while processing your request.</p>
    @if (ViewBag.RequestId != null)
    {
        <p class="small text-muted">Request ID: <code>@ViewBag.RequestId</code></p>
    }
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-success"><i class="bi bi-house"></i> Back to Dashboard</a>
</div>
