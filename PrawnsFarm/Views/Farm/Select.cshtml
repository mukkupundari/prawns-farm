@model List<PrawnsFarm.Models.Entities.FarmProfile>
@{
    Layout = null;
    ViewData["Title"] = "Select Farm";
    var currentId = ViewBag.CurrentFarmId as int?;
    var photos = new[] { "farm-1.jpg", "farm-2.jpg", "farm-3.jpg" };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Select Farm - Prawns Farm</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="farm-select-page">
    <div class="login-bg" style="background-image:url('/img/farm-select-bg.jpg?v=2')" aria-hidden="true"></div>
    <div class="login-overlay" aria-hidden="true"></div>
    <div class="bubbles" id="bubbles" aria-hidden="true"></div>

    <div class="farm-select">
        <div class="farm-select-head">
            <div class="brand-logo lg"><img src="~/img/logo.svg" alt="Prawns Farm" /></div>
            <h1>Choose a <span>Farm</span></h1>
            <p>Select which farm you want to work in. You can switch anytime from your profile menu.</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mx-auto" style="max-width:520px">@TempData["Error"]</div>
        }

        <div class="farm-board">
            @for (int i = 0; i < Model.Count; i++)
            {
                var f = Model[i];
                var accent = string.IsNullOrEmpty(f.AccentColor) ? "#16a34a" : f.AccentColor;
                var photo = photos[i % photos.Length];
                <form asp-controller="Farm" asp-action="Enter" method="post" class="farm-card-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@f.Id" />
                    <button type="submit" class="farm-tilt-card @(currentId == f.Id ? "current" : "")" style="--accent:@accent">
                        <span class="ftc-inner">
                            <span class="ftc-top">
                                <span class="farm-badge" style="background:@accent">@(f.Code ?? "F")</span>
                                <span class="ftc-name">@f.FarmName</span>
                                <span class="ftc-go" style="--accent:@accent"><i class="bi bi-arrow-right"></i></span>
                            </span>
                            <span class="ftc-meta">
                                <span><i class="bi bi-geo-alt"></i> @f.Location</span>
                                <span><i class="bi bi-rulers"></i> @f.LandAreaAcres.ToString("0.00") acres &nbsp;&bull;&nbsp; @f.FarmType</span>
                            </span>
                            <span class="ftc-photo"><img src="~/img/@photo" alt="@f.FarmName" /></span>
                        </span>
                    </button>
                </form>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ---- Rising bubbles ----
        (function () {
            var layer = document.getElementById('bubbles');
            if (!layer || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            function rand(a, b) { return Math.random() * (b - a) + a; }
            function spawn() {
                var b = document.createElement('span');
                b.className = 'bubble';
                var s = rand(6, 24);
                b.style.width = s + 'px'; b.style.height = s + 'px';
                b.style.left = rand(0, 100) + 'vw';
                var d = rand(7, 15);
                b.style.animationDuration = d + 's';
                b.style.setProperty('--drift', rand(-60, 60) + 'px');
                b.style.opacity = rand(0.15, 0.5);
                layer.appendChild(b);
                setTimeout(function () { b.remove(); }, d * 1000 + 200);
            }
            for (var i = 0; i < 10; i++) setTimeout(spawn, i * 300);
            setInterval(function () { spawn(); }, 1000);
        })();

        // ---- 3D tilt on the farm cards ----
        (function () {
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            var cards = document.querySelectorAll('.farm-tilt-card');
            cards.forEach(function (card) {
                var max = 10; // degrees
                card.addEventListener('pointermove', function (e) {
                    var r = card.getBoundingClientRect();
                    var px = (e.clientX - r.left) / r.width - 0.5;
                    var py = (e.clientY - r.top) / r.height - 0.5;
                    card.style.transform = 'rotateY(' + (px * max) + 'deg) rotateX(' + (-py * max) + 'deg) translateY(-6px)';
                });
                card.addEventListener('pointerleave', function () { card.style.transform = ''; });
            });
        })();
    </script>
</body>
</html>
